{
  "$defs": {
    "NA": {
      "additionalProperties": false,
      "properties": {
        "not_applicable": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "not_applicable"
      ],
      "type": "object"
    }
  },
  "$id": "https://ds-engine.local/schemas/glossary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "terms": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "assumption": {
            "minLength": 1,
            "type": "string"
          },
          "avoid": {
            "items": {
              "minLength": 1,
