            },
            "type": "array"
          },
          "definition": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "pattern": "^[a-z0-9_.-]+$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "entity",
              "state",
              "role",
              "action",
              "ui"
            ]
          },
          "labels": {
            "additionalProperties": {
              "minLength": 1,
              "type": "string"
            },
            "type": "object"
          },
          "source": {
            "enum": [
              "brief",
              "glossary_seed",
              "derived",
              "pack"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "labels",
          "definition",
          "avoid",
          "source"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "terms"
  ],
  "title": "glossary",
  "type": "object"
}
