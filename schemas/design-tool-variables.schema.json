{
  "$defs": {
    "NA": {
      "additionalProperties": false,
      "properties": {
        "not_applicable": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "not_applicable"
      ],
      "type": "object"
    }
  },
  "$id": "https://ds-engine.local/schemas/design-tool-variables.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "collections": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "hidden_from_publishing": {
            "type": "boolean"
          },
          "modes": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "name": {
            "enum": [
              "primitive",
              "color",
              "brand",
              "size",
              "component"
            ]
          },
          "variables": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "minLength": 1,
                  "type": "string"
                },
                "scopes": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "type": "array"
                },
                "token": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "COLOR",
                    "FLOAT",
                    "STRING",
                    "BOOLEAN"
                  ]
                },
                "values": {
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      },
                      {
                        "additionalProperties": false,
                        "properties": {
                          "alias": {
                            "minLength": 1,
                            "type": "string"
                          }
                        },
                        "required": [
                          "alias"
                        ],
                        "type": "object"
                      }
                    ]
                  },
                  "type": "object"
                }
              },
              "required": [
                "name",
                "token",
                "type",
                "scopes",
                "values"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "name",
          "modes",
          "hidden_from_publishing",
          "variables"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "tool": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "tool",
    "collections"
  ],
  "title": "design-tool-variables",
  "type": "object"
}
