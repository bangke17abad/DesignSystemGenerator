{
  "$defs": {
    "NA": {
      "additionalProperties": false,
      "properties": {
        "not_applicable": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "not_applicable"
      ],
      "type": "object"
    }
  },
  "$id": "https://ds-engine.local/schemas/lint-rules.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "rules": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "applies_to": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "pattern": "^(UB\\d{1,2}|LB-\\d{2}|ENG-[A-Z]+|VB\\d{1,2}|P\\d{2}-[A-Z0-9-]+)$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "css-pattern",
              "token-rule",
              "manual-review"
            ]
          },
          "pattern": {
            "minLength": 1,
            "type": "string"
          },
          "question": {
            "minLength": 1,
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "review"
            ]
          },
          "source": {
            "minLength": 1,
            "type": "string"
          },
          "statement": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "statement",
          "kind",
          "applies_to",
          "source",
          "severity"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "rules"
  ],
  "title": "lint-rules",
  "type": "object"
}
