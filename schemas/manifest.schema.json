  "required": [
    "engine_version",
    "brief_schema_version",
    "brief_sha256",
    "run_mode",
    "package_version",
    "version_label",
    "namespace",
    "doc_language",
    "report_language",
    "language",
    "axes",
    "surfaces",
    "targets",
    "components",
    "patterns",
    "core_exclusions",
    "pattern_exclusions",
    "packs",
    "packages",
    "budgets",
    "support_matrix",
    "documents",
    "generated",
    "manual_zones"
  ],
  "title": "manifest",
  "type": "object"
}
