{
  "$defs": {
    "NA": {
      "additionalProperties": false,
      "properties": {
        "not_applicable": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "not_applicable"
      ],
      "type": "object"
    }
  },
  "$id": "https://ds-engine.local/schemas/assumptions.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "confirm_by": {
            "minLength": 1,
            "type": "string"
          },
          "default_taken": {
            "minLength": 1,
            "type": "string"
          },
          "files": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "pattern": "^A-\\d{2,}$",
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "statement": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "needs owner confirmation",
              "confirmed",
              "rejected"
            ]
          }
        },
        "required": [
          "id",
          "statement",
          "reason",
          "default_taken",
          "confirm_by",
          "status",
          "files"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "entries"
  ],
  "title": "assumptions",
  "type": "object"
}
